# WhisperFlow GPU Server - systemd unit file
#
# This service runs the GPU-accelerated transcription server
# (faster-whisper on CUDA). It listens for audio from WhisperFlow
# clients and returns transcriptions.
#
# Installation:
#   sudo cp whisperflow-gpu.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now whisperflow-gpu.service
#
# Prerequisites:
#   sudo useradd --system --shell /usr/sbin/nologin whisperflow
#   sudo mkdir -p /opt/whisperflow
#   pip install whisperflow[gpu-server] into a virtualenv or system-wide
#   NVIDIA drivers and CUDA toolkit must be installed
#
# Logs:
#   journalctl -u whisperflow-gpu -f

[Unit]
Description=WhisperFlow GPU Transcription Server
Documentation=https://github.com/whisperflow/whisperflow
After=network.target

[Service]
Type=simple
User=whisperflow
Group=whisperflow
WorkingDirectory=/opt/whisperflow

ExecStart=/usr/bin/env whisperflow-server --host 0.0.0.0 --port 8765

# Optional environment variables — uncomment and set as needed:
# WHISPERFLOW_API_KEY protects the server API with a bearer token
# WHISPERFLOW_DATA_DIR overrides the default data/config directory
Environment=WHISPERFLOW_API_KEY=
Environment=WHISPERFLOW_DATA_DIR=

# You can also load environment from a file:
# EnvironmentFile=/etc/whisperflow/whisperflow.env

Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/whisperflow
PrivateTmp=true

[Install]
WantedBy=multi-user.target
